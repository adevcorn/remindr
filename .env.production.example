# Environment Configuration Template for Production

# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

#############################################
# Database Configuration
#############################################

# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://remindr_prod:CHANGE_ME@postgres-prod.example.com:5432/remindr_prod

#############################################
# Redis Configuration
#############################################

# Redis connection string for Celery and caching
# Format: redis://hostname:port/db_number
REDIS_URL=redis://redis-prod.example.com:6379/0

#############################################
# Application Security
#############################################

# Secret key for JWT tokens and session management
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECURE_STRING

#############################################
# Google Cloud Configuration
#############################################

# Path to Google Cloud service account JSON key
# This service account needs permissions for:
# - Cloud Speech-to-Text API
# - Cloud Vision API (OCR)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json

# Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

#############################################
# Google OAuth 2.0 Configuration
#############################################

# OAuth 2.0 credentials for Google Tasks and Calendar API
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

#############################################
# AI/NLP Configuration
#############################################

# Minimum confidence threshold for auto-filing tasks/events
# Range: 0.0 to 1.0 (higher = more strict)
# PRD Target: ≥ 90% classification accuracy
AI_CONFIDENCE_THRESHOLD=0.85

#############################################
# Sync Engine Configuration
#############################################

# Maximum number of retry attempts for failed sync operations
SYNC_RETRY_MAX_ATTEMPTS=5

# Exponential backoff base for retry delays
# Delay calculation: BACKOFF_BASE ^ attempt_number seconds
SYNC_RETRY_BACKOFF_BASE=2

#############################################
# API Configuration
#############################################

# API version prefix
API_V1_PREFIX=/api/v1

# Allowed CORS origins (comma-separated)
# Production: Set to your actual frontend domain
CORS_ORIGINS=https://app.remindr.example.com,https://www.remindr.example.com

#############################################
# Performance & Scaling (Optional)
#############################################

# Number of Celery worker processes (default: number of CPU cores)
# CELERY_WORKER_CONCURRENCY=4

# Maximum number of tasks per worker before restart (prevents memory leaks)
# CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Database connection pool size (default: 5)
# DB_POOL_SIZE=10

# Database connection pool timeout in seconds (default: 30)
# DB_POOL_TIMEOUT=30

#############################################
# Monitoring & Logging (Optional)
#############################################

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Application insights or monitoring service (optional)
# MONITORING_ENDPOINT=https://monitoring.example.com/api/v1/metrics

#############################################
# Feature Flags (Optional - MVP)
#############################################

# Enable/disable specific capture methods
# ENABLE_VOICE_CAPTURE=true
# ENABLE_IMAGE_CAPTURE=true
# ENABLE_TEXT_CAPTURE=true

# Enable/disable specific sync targets
# ENABLE_GOOGLE_TASKS_SYNC=true
# ENABLE_GOOGLE_CALENDAR_SYNC=true

#############################################
# Development/Testing Only
#############################################

# Set to 'true' to enable debug mode (DO NOT use in production)
# DEBUG=false

# Set to 'true' to enable SQL query logging
# SQL_ECHO=false
